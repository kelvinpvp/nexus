// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GifProviderType {
  GIPHY
  TENOR
}

model FavoriteGif {
  id            String          @id @default(uuid())
  userId        String
  provider      GifProviderType
  providerGifId String
  url           String
  previewUrl    String?
  width         Int?
  height        Int?
  title         String?
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerGifId])
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  password    String
  displayName String?
  avatarUrl   String?
  status      String   @default("offline") // online, offline, idle, dnd
  customStatus String?
  bio         String?
  bannerUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  sessions    Session[]
  serversOwned Server[]
  memberships  ServerMember[]
  messages     Message[]

  preference  UserPreference?

  // Social
  friendRequestsSent     FriendRequest[] @relation("RequestSender")
  friendRequestsReceived FriendRequest[] @relation("RequestReceiver")
  

  friendshipsA           Friendship[]    @relation("FriendUserA")
  friendshipsB           Friendship[]    @relation("FriendUserB")

  blocksInitiated        Block[]         @relation("Blocker")
  blocksReceived         Block[]         @relation("Blocked")

  // DMs & Groups
  conversationParticipations ConversationParticipant[]
  directMessages             DirectMessage[]
  callsInitiated             CallSession[]
  ownedConversations         Conversation[]  @relation("ConversationOwner")

  // Invites & Moderation
  createdInvites             ServerInvite[]  @relation("InviteCreator")
  bansReceived               ServerBan[]     @relation("BannedUser")
  bansIssued                 ServerBan[]     @relation("BanModerator")
  auditActions               AuditLog[]      @relation("AuditActor")
  
  attachments                Attachment[]
  favoriteGifs               FavoriteGif[]
}

enum ScreenShareQuality {
  AUTO
  P720_30
  P1080_30
  P1080_60
  MAX
}

enum CameraQuality {
  AUTO
  P720
  P1080
}

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  joinMuted           Boolean  @default(false)
  joinDeafened        Boolean  @default(false)
  screenShareQuality  ScreenShareQuality @default(AUTO)
  cameraQuality       CameraQuality @default(AUTO)
  theme               String   @default("dark")
  messageDisplay      String   @default("cozy")
  reducedMotion       Boolean  @default(false)
  notificationSounds  Boolean  @default(true)
  desktopNotifications Boolean @default(true)
  friendRequestPolicy String   @default("EVERYONE") // EVERYONE, FRIENDS_OF_FRIENDS, SERVER_MEMBERS, NOBODY
  allowServerDMs      Boolean  @default(true)
  audioInputDeviceId  String?
  audioOutputDeviceId String?
  noiseSuppressionEnabled Boolean @default(true)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  IGNORED
}

model FriendRequest {
  id          String        @id @default(cuid())
  senderId    String
  sender      User          @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User          @relation("RequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("FriendUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("FriendUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Server {
  id          String   @id @default(cuid())
  name        String
  iconUrl     String?
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ServerMember[]
  roles       Role[]
  categories  Category[]
  channels    Channel[]
  invites     ServerInvite[]
  bans        ServerBan[]
  auditLogs   AuditLog[]
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Role {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#99AAB5")
  position    Int      @default(0)
  permissions String   @default("0") // BigInt stored as String for safety
  isDefault   Boolean  @default(false) // @everyone role flag
  mentionable Boolean  @default(false)

  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  members     ServerMemberRole[]
  overrides   ChannelPermissionOverride[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serverId, position])
}

model ServerMember {
  id             String     @id @default(cuid())
  role           MemberRole @default(MEMBER)
  nickname       String?
  timeoutUntil   DateTime?
  serverMuted    Boolean    @default(false)
  serverDeafened Boolean    @default(false)

  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId       String
  server         Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)

  roles          ServerMemberRole[]
  overrides      ChannelPermissionOverride[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, serverId])
}

model ServerMemberRole {
  id        String       @id @default(cuid())
  memberId  String
  member    ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels  Channel[]
}

enum ChannelType {
  TEXT
  VOICE
  STAGE
  FORUM
  MEDIA
  ANNOUNCEMENT
}

model Channel {
  id         String      @id @default(cuid())
  name       String
  type       ChannelType @default(TEXT)
  topic      String?
  userLimit  Int         @default(0) // 0 = unlimited for voice channels
  order      Int         @default(0)
  
  serverId   String
  server     Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  overrides  ChannelPermissionOverride[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  messages   Message[]
}

enum OverrideType {
  ROLE
  MEMBER
}

model ChannelPermissionOverride {
  id        String       @id @default(cuid())
  type      OverrideType @default(ROLE)
  allow     String       @default("0")
  deny      String       @default("0")

  channelId String
  channel   Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  roleId    String?
  role      Role?        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  memberId  String?
  member    ServerMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([channelId, roleId])
  @@unique([channelId, memberId])
}

model ServerBan {
  id          String   @id @default(cuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderatorId String
  moderator   User     @relation("BanModerator", fields: [moderatorId], references: [id], onDelete: Cascade)
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([serverId, userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String?
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([serverId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  isEdited  Boolean  @default(false)
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- DIRECT MESSAGES ---

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType @default(DIRECT)
  name      String?
  iconUrl   String?
  ownerId   String?
  owner     User?            @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  
  participants ConversationParticipant[]
  messages     DirectMessage[]
  calls        CallSession[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([userId, conversationId])
}

enum MessageType {
  TEXT
  GIF
  IMAGE
  FILE
  SYSTEM
}

model DirectMessage {
  id             String       @id @default(cuid())
  content        String
  type           MessageType  @default(TEXT)
  metadata       Json?
  isEdited       Boolean      @default(false)
  
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  attachments    Attachment[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// --- ATTACHMENTS ---
enum AttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum AttachmentStatus {
  PENDING
  READY
  ATTACHED
  ABANDONED
}

model Attachment {
  id               String   @id @default(cuid())
  
  uploaderId       String
  uploader         User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  
  storageKey       String   @unique
  storageProvider  String
  
  originalFilename String
  mimeType         String
  sizeBytes        Int
  
  width            Int?
  height           Int?
  durationMs       Int?
  
  kind             AttachmentKind
  status           AttachmentStatus @default(PENDING)
  
  messageId        String?
  message          Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  
  directMessageId  String?
  directMessage    DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([uploaderId])
  @@index([messageId])
  @@index([directMessageId])
}

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  DECLINED
  MISSED
  ENDED
}

model CallSession {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  initiatorId    String
  initiator      User         @relation(fields: [initiatorId], references: [id], onDelete: Cascade)
  
  type           CallType     @default(VOICE)
  status         CallStatus   @default(RINGING)
  
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?
  endedAt        DateTime?
}

model ServerInvite {
  id        String   @id @default(cuid())
  code      String   @unique
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User     @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  uses      Int      @default(0)
  maxUses   Int      @default(0) // 0 = unlimited
  expiresAt DateTime?
  createdAt DateTime @default(now())
}
