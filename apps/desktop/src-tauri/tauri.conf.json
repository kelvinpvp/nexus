{
  "productName": "Nexus",
  "version": "1.1.6",
  "identifier": "com.nexus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop -w web",
    "beforeBuildCommand": "npm run build:desktop -w web",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Nexus",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMERBMTg2NTM5QjdDNDgKUldSSWZKdFRocUVOY2Z6TFMvWXllWnNjOTRuTk9HcmVOc3Y4WC8zWFBBUk92WGpMYmRkV0lSZmsK",
      "endpoints": [
        "https://github.com/kelvinpvp/nexus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
