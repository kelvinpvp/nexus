NODE_ENV=development

APP_NAME=Nexus

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://nexus_user:nexus_password@localhost:5432/nexus?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security
SESSION_SECRET="super_secret_session_key_change_in_production_123456"

# LiveKit (WebRTC)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TURN/STUN (WebRTC Fallback)
STUN_URL=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Uploads
UPLOAD_PROVIDER=local
UPLOAD_PATH=./uploads
