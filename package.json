{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "npm run db:migrate -w backend",
    "db:generate": "npm run db:generate -w backend",
    "desktop:dev": "npm run tauri dev -w desktop",
    "desktop:build": "npm run tauri build -w desktop"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "npm@11.11.0"
}
